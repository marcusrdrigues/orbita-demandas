# Copie para .env (que não vai para o repositório): cp .env.example .env
# Os valores abaixo funcionam como estão, mas são SÓ para desenvolvimento local:
# o MySQL do compose escuta apenas em 127.0.0.1. Em qualquer outro ambiente, troque as senhas.

# --- MySQL (docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=orbita_root_dev
MYSQL_PASSWORD=orbita_dev
MYSQL_PORT=3307

# --- API (api/src/infra/config.ts); DB_PASSWORD deve ser igual a MYSQL_PASSWORD ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=orbita
DB_PASSWORD=orbita_dev
DB_NAME=orbita
DB_NAME_TESTE=orbita_teste
PORT=3000
